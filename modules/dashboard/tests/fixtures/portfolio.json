        "forecast": [{ "month": "2026-10", "billed": 55555 }, { "month": "2026-11", "billed": 30000 }, { "month": "2027-01", "billed": 40000 }, { "month": "2027-05", "billed": 70000 }],
        "plannedHours": [],
        "hours": { "planYtd": 400, "actualYtd": 430 },
        "ar": { "current": 5000, "d31": 2000, "d61": 1000, "d91": 500 }
      },
      "expect": {
        "ytd": { "billed": 200000, "spent": 110000, "profit": 90000, "profitPct": 45 },
