  {
   "name": "reimbursable allowance ignored by default",
   "definition": "feeConsult",
   "row": {
    "gross": 1000000,
    "fee": 7000000,
    "consultFee": 3000000,
    "reimbAllow": 1000000
   },
   "expect": {
    "amount": 700000,
    "issue": null
   },
   "why": "same as the owner example"
  },
  {
   "name": "reimbursable allowance included when chosen",
   "definition": "feeConsultReimb",
