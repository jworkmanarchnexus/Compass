  {
   "name": "rounding to the cent, half to even",
   "definition": "feeConsult",
   "row": {
    "gross": 1,
    "fee": 2,
    "consultFee": 1,
    "reimbAllow": 0
   },
   "expect": {
    "amount": 1,
