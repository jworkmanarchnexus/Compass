{
  "note": "The PDF is always two pages: the PIC table and charts, then the market sector table and charts. Expect: the section ids on each page. shrinks: some page is shrunk to fit; small: the type falls below readable.",
  "cases": [
    {
      "name": "Letter portrait (the default): two pages, nothing shrunk",
      "paper": "letter",
      "orientation": "portrait",
      "pic": 8,
      "sector": 6,
      "head": "logo",
      "expect": [
        [
          "picTable",
          "firmChart",
          "picChart"
        ],
        [
          "sectorTable",
          "firmChartMarket",
          "sectorChart"
        ]
      ],
      "shrinks": false
    },
    {
      "name": "Tabloid portrait: two pages, nothing shrunk",
      "paper": "tabloid",
      "orientation": "portrait",
      "pic": 8,
      "sector": 6,
      "head": "logo",
      "expect": [
        [
          "picTable",
          "firmChart",
          "picChart"
        ],
        [
          "sectorTable",
          "firmChartMarket",
          "sectorChart"
        ]
      ],
      "shrinks": false
    },
    {
      "name": "A4 portrait: two pages",
      "paper": "a4",
      "orientation": "portrait",
      "pic": 8,
      "sector": 6,
      "head": "logo",
      "expect": [
        [
          "picTable",
          "firmChart",
          "picChart"
        ],
        [
          "sectorTable",
          "firmChartMarket",
          "sectorChart"
        ]
      ]
    },
    {
      "name": "Letter landscape: still two pages; each shrinks to fit, never a third page",
      "paper": "letter",
      "orientation": "landscape",
      "pic": 8,
      "sector": 6,
      "head": "logo",
      "expect": [
        [
          "picTable",
          "firmChart",
          "picChart"
        ],
        [
          "sectorTable",
          "firmChartMarket",
          "sectorChart"
        ]
      ],
      "shrinks": true
    },
    {
      "name": "A long PIC list shrinks its page rather than spilling over",
      "paper": "letter",
      "orientation": "portrait",
      "pic": 30,
      "sector": 6,
      "head": "logo",
      "expect": [
        [
          "picTable",
