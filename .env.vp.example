# Copy this file to `.env.vp` (same folder) and fill it in yourself. `.env.vp` is git-ignored.
# Never paste these values into a chat, an issue or a commit.

# The Windows ODBC data source name (the same one DBeaver uses). It holds the server address.
VP_DSN=VantagePoint
# The sign-in name and password for Vantagepoint.
VP_USER=
VP_PASSWORD=
# Optional: only if the data source does not already pick the database.
# VP_DATABASE=

# Safety limits (defaults shown)
# VP_QUERY_TIMEOUT_S=30
# VP_ROW_LIMIT=200
