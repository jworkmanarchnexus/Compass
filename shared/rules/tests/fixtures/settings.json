{
  "settingAt": [
    {
      "name": "no rows gives the default",
      "rows": [],
      "key": "due.missedAfterDays",
      "at": 1000,
      "expect": 14
    },
    {
      "name": "a row not yet in force is ignored",
      "rows": [
        {
          "key": "due.missedAfterDays",
          "value": 7,
          "effectiveFrom": 2000
        }
      ],
      "key": "due.missedAfterDays",
      "at": 1000,
      "expect": 14
    },
    {
      "name": "the latest row in force wins",
      "rows": [
        {
          "key": "due.missedAfterDays",
          "value": 7,
          "effectiveFrom": 500
        },
        {
          "key": "due.missedAfterDays",
          "value": 10,
          "effectiveFrom": 900
        },
        {
          "key": "due.missedAfterDays",
          "value": 3,
          "effectiveFrom": 2000
        }
      ],
      "key": "due.missedAfterDays",
      "at": 1000,
      "expect": 10
    },
    {
      "name": "rows of other keys do not interfere",
      "rows": [
        {
          "key": "ladder.escalateDays",
          "value": 45,
          "effectiveFrom": 1
        }
      ],
      "key": "due.missedAfterDays",
      "at": 1000,
      "expect": 14
    },
    {
      "name": "an old run still sees the old value",
      "rows": [
        {
          "key": "ladder.escalateDays",
          "value": 45,
          "effectiveFrom": 5000
        }
      ],
      "key": "ladder.escalateDays",
      "at": 4999,
      "expect": 21
    }
